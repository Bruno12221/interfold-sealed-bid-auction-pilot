# Export these in your shell or use node --env-file=.env cli.mjs ... . Never commit .env.
RAILGUN_SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
RAILGUN_POI_URLS=https://ppoi.fdi.network
RAILGUN_GRAPHQL_URL=https://rail-squid.squids.live/squid-railgun-eth-sepolia-v2/graphql
# Public test-only funder address; needed for shield simulation, no key needed for prepare.
RAILGUN_FUNDER_ADDRESS=
RAILGUN_COLLATERAL_WEI=1000000000000000
RAILGUN_GAS_BUDGET_WEI=200000000000000
# Operator cap/budget only, not a live broadcaster quote. Live fee must fit this budget.
RAILGUN_BROADCASTER_BUDGET_WEI=200000000000000
# Optional PUBLIC JSON for read-only broadcaster probe/preflight only.
# Supports a public 0zk operator allowlist and verified custom ENR DNS discovery.
# This does not configure send commands or create a live fee quote.
# RAILGUN_BROADCASTER_CONFIG=/absolute/path/operator-probe.json
# additionalDirectPeers and pubSubTopic overrides are rejected: the pinned Node
# client ignores direct peers and hardcodes its encoder/decoder shard to 1/1.
# Only send commands need this: reproducible verifiers + known-answer proof file.
PILOT_RELEASE_MANIFEST=../../pilot/release-manifest.json
# Set RAILGUN_FUNDER_PRIVATE_KEY via your local secret manager only for shield-send.
